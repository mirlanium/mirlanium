---
import Base from '../layouts/Base.astro';

const projects = [
  {
    title: 'nxtAIM',
    year: '2024–present',
    desc: 'A federally funded research initiative using generative AI to create photorealistic synthetic driving data for training and validating autonomous driving perception. Leading Data Consolidation and Foundation Model training across consortium partners.',
    links: [{ label: 'project', url: 'https://nxtaim.de/en/home/' }],
  },
];

const publications = [
  {
    title: 'Localized Semantic Alignment for Temporally Consistent Driving Video Generation',
    venue: 'Published as Oral at IV2026',
    year: '2026',
    arxiv: 'https://arxiv.org/abs/2602.05966',
    code: 'coming soon',
  },
];
---

<Base title="Research" activePage="research">
  <h1 class="page-title">Research</h1>
  <p class="section-intro">
    Temporal consistency in video generation for autonomous driving.
    All work centers on Orbis as the primary experimental platform.
  </p>

  <h2 class="section-title">Projects</h2>
  {projects.map((p) => (
    <details class="project-item">
      <summary class="project-header">
        <span class="project-title">{p.title}</span>
        <span class="project-year">{p.year}</span>
      </summary>
      {p.target && <span class="project-target">→ {p.target}</span>}
      <p class="project-desc">{p.desc}</p>
      {p.links.length > 0 && (
        <div class="project-links">
          {p.links.map((l) => (
            <a href={l.url} class="project-link-item">[{l.label}]</a>
          ))}
        </div>
      )}
    </details>
  ))}

  <h2 class="section-title" style="margin-top: 48px;">Publications</h2>
  {publications.map((p) => (
    <div class="pub-item">
      <span class="pub-title">{p.title}</span>
      <span class="pub-meta">
        {p.venue}, {p.year} ·
        <a href={p.arxiv}> [arXiv]</a>
        <a href={p.code}> [code]</a>
      </span>
    </div>
  ))}
</Base>

<style>
  details.project-item summary {
    cursor: pointer;
    list-style: none;
  }
  details.project-item summary::-webkit-details-marker {
    display: none;
  }
</style>
