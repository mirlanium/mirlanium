---
import Base from '../layouts/Base.astro';

const experience = [
  {
    role: 'PhD Researcher',
    org: 'ETH Zurich',
    period: '01.10.2024 – present',
    note: 'Video generation and world models for autonomous driving.',
  },
  {
    role: 'Student Researcher',
    org: 'Mercedes-Benz AG',
    period: '2024 – present',
    note: 'Research on end-to-end autonomous driving',
  },
  {
    role: 'Student Researcher',
    org: 'Google Zurich',
    period: '2022 – 2023',
    note: 'Research on Neural Radiance Fields',
  },
];
---

<Base title="Experience" activePage="experience">
  <h1 class="page-title">Experience</h1>
  {experience.map((e) => (
    <div class="exp-item">
      <div class="exp-header">
        <span class="exp-role">{e.role}</span>
        <span class="exp-period">{e.period}</span>
      </div>
      <span class="exp-org">{e.org}</span>
      <p class="exp-note">{e.note}</p>
    </div>
  ))}
</Base>
