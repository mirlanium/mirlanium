---
import Base from '../layouts/Base.astro';
---

<Base title="Music" activePage="music">
  <h1 class="page-title">Music</h1>
  <div class="body-text">
    <p>
      I make ambient, textural, and deep electronic music using Eurorack
      modular synthesis. My work gravitates toward granular processing of
      the human voice — decomposing it into particles and reassembling
      it into something that sits between the organic and the synthetic.
    </p>
    <p>
      Live, I play long-form sets in the tradition of deep and hypnotic
      techno, building slowly from texture into rhythm and back.
    </p>
  </div>

  <!-- Replace these with real SoundCloud/Bandcamp embeds -->
  <div class="music-player">
    <div class="music-player-inner">
      <span class="music-player-icon">▶</span>
      <div>
        <span class="music-track-title">Granular Study No. 3</span>
        <span class="music-track-meta">ambient · 8:42</span>
      </div>
    </div>
  </div>

  <div class="music-player">
    <div class="music-player-inner">
      <span class="music-player-icon">▶</span>
      <div>
        <span class="music-track-title">Live at ▮▮▮▮</span>
        <span class="music-track-meta">deep techno · 54:17</span>
      </div>
    </div>
  </div>

  <p class="music-placeholder">
    SoundCloud / Bandcamp embeds will replace these placeholders.
  </p>
</Base>
