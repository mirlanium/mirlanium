---
import Base from '../layouts/Base.astro';
---

<Base title="Music" activePage="music">
  <h1 class="page-title">Music</h1>
  <div class="body-text">
    <p>
      I make ambient, textural, and deep electronic music. I am new in this journey but music production has already shaped a part of me and is here to stay.
    </p>
    <p>
      My vision is to play long-form, slow=evolving live sets in the tradition of deep and hypnotic
      techno, building slowly from texture into rhythm and back.
    </p>
  </div>

  <!-- Replace these with real SoundCloud/Bandcamp embeds -->
  <div class="music-player">
    <div class="music-player-inner">
      <span class="music-player-icon">▶</span>
      <div>
        <span class="music-track-title">Granular Study No. 3</span>
        <span class="music-track-meta">ambient · 8:42</span>
      </div>
    </div>
  </div>

  <div class="music-player">
    <div class="music-player-inner">
      <span class="music-player-icon">▶</span>
      <div>
        <span class="music-track-title">Live at ▮▮▮▮</span>
        <span class="music-track-meta">deep techno · 54:17</span>
      </div>
    </div>
  </div>

  <p class="music-listen">
    You can listen to my music on <a href="https://soundcloud.com/mirlanium" target="_blank" rel="noopener">SoundCloud</a>.
  </p>
</Base>
